# Copy to .env for local runs. Keep secrets out of committed files and artifacts.

COMPOSE_PROJECT_NAME=portfolio-systems

# Public entrypoints
GATEWAY_PORT=8000
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
JAEGER_UI_PORT=16686

# Database
POSTGRES_DB=portfolio_analytics
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=replace-with-local-secret
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DSN=postgresql://portfolio:replace-with-local-secret@postgres:5432/portfolio_analytics
POSTGRES_DSN_IN_COMPOSE=postgresql://portfolio:replace-with-local-secret@postgres:5432/portfolio_analytics

# Serving admission/concurrency
GATEWAY_MAX_IN_FLIGHT=64
GATEWAY_QUEUE_CAPACITY=256
GATEWAY_QUEUE_TIMEOUT_SECONDS=2.0
GATEWAY_DOWNSTREAM_TIMEOUT_SECONDS=60.0
PORTFOLIO_CPU_WORKERS=8
PORTFOLIO_MAX_CONCURRENT_METRIC_TASKS=8

# Inference endpoint used by PortfolioRuntime/Advisor
PORTFOLIO_INFERENCE_BASE_URL=http://vllm:8000/v1
PORTFOLIO_INFERENCE_MODEL=Qwen/Qwen3-4B-Instruct-2507
PORTFOLIO_INFERENCE_MAX_TOKENS=256
PORTFOLIO_INFERENCE_TEMPERATURE=0
PORTFOLIO_INFERENCE_TIMEOUT_SECONDS=60
PORTFOLIO_INFERENCE_RETRY_COUNT=0

# vLLM profile. HF_TOKEN is optional for public model access/cache warming.
HF_TOKEN=
VLLM_MODEL=Qwen/Qwen3-4B-Instruct-2507
VLLM_SERVED_MODEL_NAME=Qwen/Qwen3-4B-Instruct-2507
# Required for canonical GPU runs: immutable Hugging Face commit SHA.
VLLM_MODEL_REVISION=
VLLM_DTYPE=bfloat16
VLLM_MAX_MODEL_LEN=4096
VLLM_MAX_NUM_SEQS=32
VLLM_MAX_NUM_BATCHED_TOKENS=
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_ENABLE_PREFIX_CACHING=
VLLM_CPU_IMAGE=public.ecr.aws/q9t5s3a7/vllm-cpu-release-repo:v0.8.5
VLLM_GPU_IMAGE=vllm/vllm-openai:v0.8.5
VLLM_CPU_KVCACHE_SPACE=8
VLLM_CPU_OMP_THREADS_BIND=0-7

# Benchmark runner profile
BENCHMARK_DATASET_MODE=canonical_100
BENCHMARK_CONCURRENCY=1
BENCHMARK_REQUEST_TIMEOUT_SECONDS=120
BENCHMARK_OUTPUT_ROOT=/results

# Observability
OBSERVABILITY_ENVIRONMENT=local
OTEL_TRACES_ENABLED=true
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
JSON_LOGGING_ENABLED=true

# Cost profile metadata for post-run analytics
COST_PROFILE_PATH=/app/configs/cost/reference_local.yaml
PROVIDER_NAME=local
PROVIDER_INSTANCE_TYPE=local-dev
MACHINE_HOURLY_USD=0
