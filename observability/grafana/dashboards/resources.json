{
  "title": "Resources",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Host CPU Utilization",
      "description": "Overall host CPU utilization. Requires node-exporter.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m])))",
          "legendFormat": "CPU utilization"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Host Load",
      "description": "One-minute host load average. Compare this with available CPU cores to identify CPU scheduling pressure.",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_load1",
          "legendFormat": "1-minute load"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Host Memory Utilization",
      "description": "Percentage of physical host memory currently in use.",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
          "legendFormat": "Memory utilization"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Host Swap Used",
      "description": "Host swap currently consumed. Zero is normal on systems configured without swap.",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_SwapTotal_bytes - node_memory_SwapFree_bytes",
          "legendFormat": "Swap used"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Host Disk Throughput",
      "description": "Aggregate host disk read and write throughput.",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(node_disk_read_bytes_total[1m]))",
          "legendFormat": "Disk read"
        },
        {
          "refId": "B",
          "expr": "sum(rate(node_disk_written_bytes_total[1m]))",
          "legendFormat": "Disk write"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Host Network Throughput",
      "description": "Aggregate host network receive and transmit throughput.",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(node_network_receive_bytes_total[1m]))",
          "legendFormat": "Network receive"
        },
        {
          "refId": "B",
          "expr": "sum(rate(node_network_transmit_bytes_total[1m]))",
          "legendFormat": "Network transmit"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Container CPU Usage",
      "description": "CPU consumption by container. 100% corresponds to approximately one fully utilized CPU core; values may exceed 100% for multithreaded containers.",
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(container_cpu_usage_seconds_total{name!=\"\"}[1m])) by (name)",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Container Memory Working Set",
      "description": "Active memory working set attributed to each container.",
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(container_memory_working_set_bytes{name!=\"\"}) by (name)",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Container Network Throughput",
      "description": "Receive and transmit network traffic attributed to each container.",
      "gridPos": {
        "x": 0,
        "y": 64,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(container_network_receive_bytes_total{name!=\"\"}[1m])) by (name)",
          "legendFormat": "{{name}} receive"
        },
        {
          "refId": "B",
          "expr": "sum(rate(container_network_transmit_bytes_total{name!=\"\"}[1m])) by (name)",
          "legendFormat": "{{name}} transmit"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "GPU Utilization",
      "description": "GPU compute utilization from NVIDIA DCGM. Expected to be empty during the local CPU rehearsal.",
      "gridPos": {
        "x": 0,
        "y": 72,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(DCGM_FI_DEV_GPU_UTIL)",
          "legendFormat": "GPU utilization"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "GPU VRAM Used",
      "description": "Total framebuffer memory used across monitored GPUs. DCGM reports this metric in MiB and the query converts it to bytes for display.",
      "gridPos": {
        "x": 0,
        "y": 80,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(DCGM_FI_DEV_FB_USED) * 1024 * 1024",
          "legendFormat": "VRAM used"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "GPU Power Draw",
      "description": "Average instantaneous GPU power consumption reported by DCGM.",
      "gridPos": {
        "x": 0,
        "y": 88,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(DCGM_FI_DEV_POWER_USAGE)",
          "legendFormat": "GPU power"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "GPU Temperature",
      "description": "Average GPU temperature reported by DCGM.",
      "gridPos": {
        "x": 0,
        "y": 96,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(DCGM_FI_DEV_GPU_TEMP)",
          "legendFormat": "GPU temperature"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "GPU Energy Consumed",
      "description": "Cumulative GPU energy consumption reported by DCGM, converted from millijoules to joules.",
      "gridPos": {
        "x": 0,
        "y": 104,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "joule"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(DCGM_FI_DEV_TOTAL_ENERGY_CONSUMPTION) / 1000",
          "legendFormat": "GPU energy"
        }
      ]
    }
  ]
}
