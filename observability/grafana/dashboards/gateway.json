{
  "title": "Gateway",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {"type": "timeseries", "title": "Inflight", "targets": [{"expr": "gateway_inflight_requests"}]},
    {"type": "timeseries", "title": "Queued", "targets": [{"expr": "gateway_queued_requests"}]},
    {"type": "timeseries", "title": "Rejections / Queue Timeouts", "targets": [{"expr": "sum(rate(gateway_admission_rejections_total[5m]))"}, {"expr": "rate(gateway_queue_timeouts_total[5m])"}]},
    {"type": "timeseries", "title": "Queue Wait", "targets": [{"expr": "histogram_quantile(0.95, sum(rate(gateway_queue_wait_duration_seconds_bucket[5m])) by (le, outcome))"}]},
    {"type": "timeseries", "title": "Status Codes", "targets": [{"expr": "sum(rate(gateway_requests_total[5m])) by (status_code)"}]},
    {"type": "timeseries", "title": "Downstream Latency / Failures", "targets": [{"expr": "histogram_quantile(0.95, sum(rate(gateway_downstream_duration_seconds_bucket[5m])) by (le))"}, {"expr": "sum(rate(gateway_downstream_failures_total[5m])) by (error_type)"}]}
  ]
}
